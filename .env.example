# Copy this file to .env for running the bot on your own machine. On
# Railway, DISCORD_TOKEN is the only variable to set.

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Optional, for local runs and calibrate.py. In the server, the owner sets
# the key with /ai-key instead.
# OPENROUTER_API_KEY=sk-or-v1-...
